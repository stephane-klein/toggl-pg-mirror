{
  "name": "toggl-pg-mirror",
  "license": "MIT",
  "author": "Stéphane Klein",
  "bin": {
    "toggl-pg-mirror": "src/cli.js"
  },
  "type": "module",
  "repository": "github:stephane-klein/toggl-pg-mirror",
  "scripts": {
    "check": "prettier --check . && eslint .",
    "format": "prettier --list-different --write .",
    "lint": "eslint .",
    "lint:pkg": "pnpm npmPkgJsonLint .",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "cli": "node src/cli.js",
    "dev": "bash scripts/export-git-env.sh vite dev",
    "build": "vite build",
    "preview": "bash scripts/export-git-env.sh vite preview",
    "postinstall": "mkdir -p node_modules/.bin && ln -sf ../../src/cli.js node_modules/.bin/toggl-pg-mirror"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "csv-parse": "~7.0.1",
    "date-fns": "~4.4.0",
    "date-fns-tz": "~3.2.0",
    "js-yaml": "~5.2.2",
    "pino": "~10.3.1",
    "pino-pretty": "~13.1.3",
    "postgres": "~3.4.9",
    "postgres-shift": "~0.1.0",
    "yargs": "~18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@sveltejs/adapter-node": "~5.5.7",
    "@sveltejs/kit": "~2.70.1",
    "@unocss/extractor-svelte": "~66.7.5",
    "eslint": "~10.7.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-svelte": "~3.22.0",
    "globals": "~17.7.0",
    "npm-package-json-lint": "~10.4.1",
    "prettier": "~3.9.6",
    "prettier-plugin-svelte": "~4.1.1",
    "svelte": "~5.56.7",
    "svelte-codemirror-search-field": "~0.11.0",
    "unocss": "~66.7.5",
    "vite": "~8.1.5"
  }
}
