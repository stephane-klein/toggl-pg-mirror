export PROJECT_NAME="toggl-pg-mirror"
export INSTANCE_ID=$(pwd | sha1sum | awk '{print $1}' | cut -c 1-12)
export COMPOSE_PROJECT_NAME=${PROJECT_NAME}_${INSTANCE_ID}

export PUBLIC_GIT_HASH=development
export PUBLIC_GIT_BRANCH=development
export PUBLIC_GIT_DATE=development
export PUBLIC_BUILD_STAMP=development

export TOGGL_PG_MIRROR_POSTGRES_SCHEMA=toggl

export TOGGL_PG_MIRROR_ADMIN_TOKEN="change-me-to-a-random-64-hex-token"

export TOGGL_PG_MIRROR_MCP_READER_POSTGRES_ROLE="toggl_mcp_reader"
export TOGGL_PG_MIRROR_MCP_READER_POSTGRES_PASSWORD="change-me-to-a-random-64-hex-token"

# SMTP configuration for outgoing emails (dev: Mailpit on localhost:1025)
export SMTP_PORT="1025"
export SMTP_USER=""
export SMTP_PASS=""
export SMTP_SECURE=""
export EMAIL_FROM="noreply@example.com"
export TEST_EMAIL_TO="john.doe@example.com"
